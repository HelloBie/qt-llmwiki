# ==========================================
# qtllmwiki 后端环境变量配置示例
# ==========================================

# 服务基础配置
APP_NAME=qtllmwiki-api
APP_ENV=dev
DEBUG=true
API_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000

# 跨域设置（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# LLM 与智能体配置（支持任何 OpenAI 兼容协议，例如 DeepSeek、OpenAI、Moonshot、Ollama 等）
LLM_PROVIDER=openai
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# Agent 迭代与系统提示词
AGENT_MAX_ITERATIONS=8
SYSTEM_PROMPT=你是一个专业、严谨且热情的 AI 助手。回答问题时请先给出核心结论，再展开具体依据。不确定或不知道的内容切勿凭空编造，请使用中文回答。
